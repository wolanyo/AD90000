<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- form view -->
        <record id="benin_petro_tv_view_form" model="ir.ui.view">
            <field name="name">benin_petro.ticket_valeur.view.form</field>
            <field name="model">benin_petro.ticket_valeur</field>
            <field name="arch" type="xml">
                <form string="Ticket Valeur">
                <header>
                    <field  name="etat" widget="statusbar" statusbar_visible="" statusbar_colors="{'KEY_IS_STATE':'VALUE_IS_COLOR'}"/>
                </header>
                    <sheet>
                        <field name="num_serie" style='font-size:35px;font-weight:bold' />
                        <field name="num_serie_incr" readonly="1" style="width: 365px;float: right;text-align: right;font-weight: bold;margin-top: 6px;"/>

                        <group>
                            <group>
                                <field name="client"/>
<!--                                <field name="tv_type" attrs="{'invisible':[('recus','=','Recus')]}"  />-->
                                <field name="tv_type"  />
                                <field name="consom"  string="Transaction"/>
                                <field name="montant_recus" attrs="{'invisible':[('recus','=','Ticket')]}"  />
                            </group>
                            <group>
                                <field name="recus"/>
                                <field name="qrcode" invisible="1"/>
                                <field name="qrcode_img" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- tree view -->
        <record id="benin_petro_tv_view_treeee" model="ir.ui.view">
            <field name="name">Liste de tickets valeur</field>
            <field name="model">benin_petro.ticket_valeur</field>
            <field name="arch" type="xml">
                <tree create='false'>
                    <field name="num_serie"/>
                    <field name="num_serie_incr"/>
                    <field name="tv_type"/>
                    <field name="create_date" string='Date de Création' />
                    <field name="etat"/>
                </tree>
            </field>
        </record>
        <!-- action window -->
        <record id="benin_petro_tv_action" model="ir.actions.act_window">
            <field name="name">Liste de T.V</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">benin_petro.ticket_valeur</field>
            <field name="view_mode">tree,form</field>
            <field name="view_type">form</field>
        </record>
        <record id="benin_petro_tv_search" model="ir.ui.view">
            <field name="name">benin_petro.tv.search</field>
            <field name="model">benin_petro.ticket_valeur</field>
            <field name="arch" type="xml">
                <search string="Search Description">
                    <!-- Add your fields here -->
                    <field name="num_serie"></field>
                      <filter name="group_by_client" context="{'group_by': 'client'}" string="Client"
                          />
                        <filter name="groupby_type" context="{'group_by': 'tv_type'}" string="Coupure"/>
                </search>
            </field>
        </record>

    </data>
</odoo>
