<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <!-- Form -->
        <record id="form_benin_petro_point_vente" model="ir.ui.view">
            <field name="name">Point de vente</field>
            <field name="model">benin_petro.point.vente</field>
            <field name="arch" type="xml">
                <form string="Point vente" >
<header>

<button name="setToActive"   string="Activer cette point de vente"  class="oe_highlight" type="object" attrs="{'invisible':[('state','not in',['suspendu','brouillon'])]}" />

<button name="setToSuspendu" string="Suspendre cette point de vente"  class="oe_highlight" type="object" attrs="{'invisible':[('state','!=','activee')]}" />

<button name="setToAnnule"   string="Fin de service"  class="oe_highlight" type="object" attrs="{'invisible':[('state','=','annule')]}" />
 

<field name="state" widget="statusbar"/>
</header>

<field name="id" invisible="1"/>
                    <group>
                        <group>
                            <field name="libelle"/>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="total_vente_tv"/>
                            <field name="adress"/>
                        </group>

                        <group>
                            <field name="account_analytic_id"/>
                            <field name="promoteur"/>
                            <!--<field name="emplacement_id"/>
                            <field name="journal_id" />-->
                            <field name="create_date" readonly="1" string="Date création"   />
                            <field name="date_suspension" readonly="1"  attrs="{'invisible':[('state','!=','suspendu')]}"/>
                            <field name="date_annulation" readonly="1"  attrs="{'invisible':[('state','!=','annule')]}"/>
                            <field name="total_vente_easy_card"/>
                        </group>
                    </group>

<notebook>
	<page string="Agents">
	    <field name="agent_ids" nolabel="1">
		<tree>
                 <field name="name" />
                 <field name="matricule" />
                 <field name="mail" />
                 <field name="state" />
		</tree>
<form>

<header>
<button name="setToActive"   string="Activer ce agent"  class="oe_highlight" type="object" attrs="{'invisible':[('state','not in',['suspendu','brouillon'])]}" />

<button name="setToSuspendu" string="Suspendre ce agent"  class="oe_highlight" type="object" attrs="{'invisible':[('state','!=','activee')]}" />

<button name="setToAnnule"   string="Fin de service"  class="oe_highlight" type="object" attrs="{'invisible':[('state','=','annule')]}" />
 

<field name="state" widget="statusbar"/>
</header>

<field name="id" invisible="1"/>

              
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="matricule"/>
                            <field name="fonction"/>
                            <field name="mail"/>
                            <field name="adress"/>
                        </group>

                        <group>
                            <field name="create_date" readonly="1" string="Date de création"   />
                            <field name="password" invisible="1"/>
                            <field name="date_suspension" readonly="1"  attrs="{'invisible':[('state','!=','suspendu')]}"/>
                            <field name="date_annulation" readonly="1"  attrs="{'invisible':[('state','!=','annule')]}"/>
                        </group>
                    </group>

</form>


	    </field>
	</page>
    <page string="Tickets valeurs" >
    <!-- readonly="1"  -->
        <field name="transaction_ids_tv" >
            <tree>
                <field name="agent_id"/>
                <field name="type_vente"/>
                <field name="product_ids"/>
                <field name="montant" widget='monetary'/>
                <field name="create_date" readonly="1" string="Date transaction"   />
            </tree>
        </field>
    </page>
    <page string="SUBLIME CARTE" >
    <!-- readonly="1"  -->
        <field name="transaction_ids_card" >
            <tree>
                <field name="agent_id"/>
                <field name="type_vente"/>
                <field name="product_ids"/>
                <field name="montant" widget='monetary'/>
                <field name="date_consommation" readonly="1" string="Date transaction"   />
            </tree>
        </field>
    </page>
	<!--<page string="Historique transactions">
	    <field name="transaction_ids" nolabel="1">
		<tree decoration-danger="state in ('annuler')">
            <field name="point_vente_id" />
            <field name="carte_id" />
            <field name="product_ids" />
            <field name="quantite" />
            <field name="montant" />
            <field name="create_date" string="Date de transaction"  />
            <field name="state" invisible="1"/>
		</tree>
	    </field>
	</page>-->
    
    <page string='Liste des demandes de consommation'>
    <!-- readonly='1' -->
        <field name="hestory_ids" >
            <tree decoration-danger="state in ('cancel')">
                <field name="type_payment"/>
                <field name="type_vente"/>
                <field name="montant"/>
                <field name="create_date" string='Date de création'/>
                <field name="state" invisible="1"/>  
                <button type='object' name='print_report' string='Imprimer la facture'
                attrs="{'invisible':[('state','=','cancel')]}"/>
                
            </tree>
        </field>
    </page>
	<page string="Historique modifications">
	    <field name="log_ids" nolabel="1" create="false">
		<tree>
                 <field name="acteur_name" />
                 <field name="champ" />
                 <field name="old_version" />
                 <field name="new_version" />
                 <field name="create_date" string="Date de modification" />
		</tree>
		<form>
		<group>
			<group>
                 <field name="acteur_name" />
                 <field name="champ" />
                 <field name="create_date" string="Date de modification" />
			</group>
			<group>
                 <field name="old_version" />
                 <field name="new_version" />
			</group>
		</group>
		</form>
	    </field>
	</page>
	<!--
pas maintenent

<page string="Produits">
	    <field name="" nolabel="1">
		<tree>
                 <field name="" />
                 <field name="" />
		</tree>
	    </field>
	    
	</page>-->
</notebook>
                </form>
            </field>
        </record>


        <!-- tree -->
        <record id="tree_benin_petro_point_vente" model="ir.ui.view">
            <field name="name">Liste des Points de vente</field>
            <field name="model">benin_petro.point.vente</field>
            <field name="arch" type="xml">
                <tree string="Point ventes" decoration-success="state in ('brouillon','activee')" decoration-danger="state in ('suspendu','annule')">
                    <field name="libelle"/>
                    <field name="type"/>
                    <field name="adress"/>
                    <field name="create_date" string="Date de création"  />
                    <field name="Total_vente" />
                    <field name="state" />
                </tree>
            </field>
        </record>


        <record id="benin_petro_point_vente_action_tree" model="ir.actions.act_window">
            <field name="name">Points de vente</field>
            <field name="res_model">benin_petro.point.vente</field>
            <field name="view_mode">tree,form</field>
            <field name="help">Point vente ...</field>
        </record>




    </data>
</odoo>
