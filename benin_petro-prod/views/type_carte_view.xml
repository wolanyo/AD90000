<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <!-- Form -->
        <record id="form_benin_petro_type_carte" model="ir.ui.view">
            <field name="name">Type de carte</field>
            <field name="model">benin_petro.type.carte</field>
            <field name="arch" type="xml">
                <form string="Type de carte" >
<header>
<!--
<button name="setToBrouillon" string="staaar B =>"  class="oe_highlight" type="object" />
 statusbar_visible="activee,expiree,terminee"
-->
<field name="state" widget="statusbar"/>
</header>

<field name="id" invisible="1"/>

              
                    <group>
                        <group>
                            <field name="libelle"/>
                        </group>

                        <group>
                            <field name="front_carte" filename="front_carte_name"/>
                            <field name="back_carte"  filename="back_carte_name"/>
                        </group>
                    </group>


<field name="front_carte_name" invisible="1"/>
<field name="back_carte_name" invisible="1"/>

                </form>
            </field>
        </record>


        <!-- tree -->
        <record id="tree_benin_petro_type_carte" model="ir.ui.view">
            <field name="name">Liste des types de carte</field>
            <field name="model">benin_petro.type.carte</field>
            <field name="arch" type="xml">
<tree string="Les types de carte" create="false" update="false" decoration-success="state in ('activee')" decoration-danger="state in ('suspendu','annule')">
    <field name="libelle"/>
    <field name="front_carte"/>
    <field name="back_carte"/>
    <field name="state" />
</tree>
            </field>
        </record>


        <record id="benin_petro_type_carte_action_tree" model="ir.actions.act_window">
            <field name="name">Type de carte</field>
            <field name="res_model">benin_petro.type.carte</field>
            <field name="view_mode">tree,form</field>
            <field name="help">Agent ...</field>
        </record>

