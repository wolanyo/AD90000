<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form -->
        <record id="rees_company_form" model="ir.ui.view">
            <field name="name">Res company</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//notebook//page[last()]" position="after">
               
                   <page string="Paramètre" name="">
                       <group>
                           <field name="picking_type"/>
                       </group>
                       <group>
                            <field name="entete" widget="image"/>
                            <field name="pied" widget="image"/>
                        </group>
                   </page>
             
                </xpath>
            </field>
        </record>
  </data>
</odoo>