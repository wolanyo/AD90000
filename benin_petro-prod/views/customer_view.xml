<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="form_benin_petro_customer" model="ir.ui.view">
            <field name="name">Customer</field>
            <field name="model">benin_petro.customer</field>
            <field name="arch" type="xml">
            <form string="Consommateur" >
                 <field name="id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" string="Nom complet"/>
                            <field name="email"/>
                            <field name="mobile" widget="phone"/>
                            <field name="taux"/>
                        </group>
                        <group>
                             <div class="o_address_format">
                                <field name="adresse" placeholder="Adresse..." class="o_address_street" />
                                <field name="city" placeholder="Ville" class="o_address_country" />
                                <field name="country_id" placeholder="Pays" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                             </div>
                        </group>
                    </group>
                </form>
            </field>
         </record>
    </data>
</odoo>
