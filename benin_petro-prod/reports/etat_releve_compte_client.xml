							</tr>
						</table>
					</div>
					</div>
					<div class="footer" style="width:100%;min-height:80px;margin-top:60px;">
                        <img class="img img-responsive" src="/benin_petro/static/img/pied.jpg"  />
                    </div>

                    </div>
                    
                
                
					
			</t>
		
		</template>
		<report
			id="etat_releve_compte_client_form"
			string="Relevé des recharges sur cartes"
			model="benin_petro.releve_compte"
			report_type="qweb-pdf"
			file="benin_petro.etat_releve_compte_client"
			name="benin_petro.etat_releve_compte_client"
			paperformat="paperformat_euro_landscape"/>
    </data>
</odoo>