<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>



        <template id="repport_tv_template">
            <t t-call="report.html_container">
                <t t-foreach="docs" t-as="doc">
                <div class="page"  >
                    <div class="row"  t-attf-style="overflow:hidden;" >
                    <div class="o_background_header" style="width:100%;height:1170px;margin-top:0px;padding:0;position:absolute;z-index:0!important;;background-size:100% 100%;">
                       <!-- <img class="img img-responsive" src="/benin_petro/static/img/tv_new.jpg" /> -->
                   </div>
                     <t t-foreach="doc.tv_ids" t-as="item">
                        <div class='col-xs-12 back' t-attf-style="width:100%;height:232px;margin-bottom:0px;overflow:hidden;background-size:100% 100%;" >
                            <style>
                                div.back:nth-child(1){
                                    height:237px!important;
                                }
                                div.back:nth-child(2){
                                    height:232px!important;
                                }
                                div.back:nth-child(4){
                                    height:232px!important;
                                }
                                div.back:nth-child(5){
                                    height:237px!important;
                                }
                                .qrcode{
                                    width: 95px;
                                    height: 68px;
                                    position: absolute;
                                    top:90px;
                                    left: 132px;
                                    z-index:5000000000000000000;
                                    border-radius:35px;
                                }
                                .qrcode2{
                                    width: 90px;
                                    height: 70px;
                                    position: absolute;
                                    top: 110px;
                                    right: 15px;
                                    z-index:1000;
                                    border-radius:35px;
                                }
                                .qrcode3{
                                    width: 65px;
                                    height: 55px;
                                    position: absolute;
                                    top: 24px;
                                    left: 280px;
                                    z-index:1000;
                                    border-radius:25px;
                                }
                                .name{
                                    width:200px;
                                    position: absolute;
                                    left: 280px;
                                    top: 95px;
                                }
                                
                                .montant_right{
                                    position:absolute;
                                    right:25px;
                                    top:170px;
                                }
                                .montant_left{
                                    position:absolute;
                                    left: 140px;
                                    top:151px;
                                }
                                .num_serie_right{
                                    position:absolute;
                                    right:18px;
                                    top:181px;
                                }
                                .num_serie_incr_right{
                                    position:absolute;
                                    right:18px;
                                    top:200px;
                                }
                                .num_serie_left{
                                    position:absolute;
                                    left: 133px;
                                    top:157px;
                                }
                                .libelle{
                                    position:absolute;
                                    left: 410px;
                                    top:30px;
                                    font-size:20px;
                                    font-weight:bold;
                                }
                            </style>
                            <br/>
                            <h5  class="libelle" style="color:black;"  t-if="doc.tv_type.libelle == 'classique'"><span t-field='item.tv_type.libelle' ></span></h5>
                            <h5  class="libelle" style="color:#1212B5;"  t-if="doc.tv_type.libelle == 'privilege'"><span t-field='item.tv_type.libelle' ></span></h5>
                            <h5  class="libelle" style="color:black;"  t-if="doc.tv_type.libelle == 'noblesse'"><span t-field='item.tv_type.libelle' ></span></h5>
                            <h5  class="name"><span t-if="doc.print_id.affiche_client == 'OUI'" t-field='item.client' ></span></h5>
                            <h5  class="montant_left"><span t-field='item.tv_type.montant' style="font-weight:bold"  ></span><span style="font-weight:bold"> CFA</span></h5>
                            <h5 class="montant_right"><span t-field='item.tv_type.montant' style="font-weight:bold" ></span><span style="font-weight:bold"> CFA</span></h5>
                            <h3 class="num_serie_left" ><span t-field='item.num_serie' style="font-size:14px;font-weight:bold" ></span></h3>
                            <h3 class="num_serie_right" ><span t-field='item.num_serie' style="font-size:14px;font-weight:bold" ></span></h3>
                            <h3 class="num_serie_incr_right"><span t-field='item.num_serie_incr' style="font-size:14px;font-weight:bold"></span></h3>

                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <img t-att-src="'/report/barcode/QR/%s' % item.qrcode" class="qrcode"/>
                            <img t-att-src="'/report/barcode/QR/%s' % item.qrcode" class="qrcode2"/>
                            <img t-att-src="'/report/barcode/QR/%s' % item.qrcode" class="qrcode3"/>
                        </div>
                       </t>
                    </div>
                    
                   
                </div>
                </t>    
            </t>
        </template>
        <report
                id="report_tv"
                string="Imprime"
                model="benin_petro.tv_print_hestory"
                report_type="qweb-pdf"
                file="repport_tv_template"
                name="benin_petro.repport_tv_template"
                paperformat="paperformat_euro_landscape"
        />
    </data>
</odoo>
