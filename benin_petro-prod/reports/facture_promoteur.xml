<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
            

		<template id="facture_promoteur">
            <t t-call="report.html_container">
				<t t-foreach="docs" t-as="doc">
										
					<div class="page" style="margin-top:20px;">
                    <style>
                        .table_facture tr th{
                            border: 1px solid black;
                            padding:5px 10px;
                        }
                        .table_facture tr td{
                            border: 1px solid black;
                            padding:5px 10px;
                        }
                        .table_facture{
                            margin-top:10px;
                            margin-bottom:10px;
                            width:100%;
                        }
                        .table_taxe tr td{
                            
                            padding : 5px 10px!important;
                            margin : 0px!important
                        }
                        .table_taxe tr{
                            margin : 0px!important
                        }
                        .table_taxe{margin:0px;padding:0px;}
						.table_produit{margin:0px;padding:0px;width:100%}
						.table_produit tr td{
                            border: 1px solid black;
                            padding:5px 10px;
                        }
                    </style>
                    <div class="header" style="width:100%;min-height:100px;margin-top:20px;;padding:0;">
						<img class="img img-responsive" src="/benin_petro/static/img/entete.jpg"/>
					</div>
                    <div class="row" style="padding:10px 80px">
                        <div class="col-xs-12">
                            <div class="col-xs-6"></div>
                            <div class="col-xs-6">
                                <table class="table_facture">
                                    <tr>
                                        <td><strong>NOTE DE CRÉDIT</strong></td>
                                        <td><span t-esc="doc.facture_num" ></span> </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Date</strong></td>
                                        <td><span t-esc="doc.create_date" ></span> </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div class="col-xs-6" style="margin:0px;padding:0px;">
                                <table class="table_facture">
                                    <tr>
                                        <td><strong>CLIENT PROMOTEUR</strong></td>
                                        <td><span t-esc="doc.tv_station.promoteur.name" ></span> </td>
                                    </tr>
                                    <tr>
                                        <td><strong>TELEPHONE</strong></td>
                                        <td><span t-esc="doc.tv_station.promoteur.mobile" ></span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>POINT DE VENTE</strong></td>
                                        <td><span t-esc="doc.tv_station.name" ></span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>TYPE DE VENTE</strong></td>
                                        <td><span t-esc="doc.type_vente" ></span></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-xs-6"></div>
                        </div>
                        <div class="col-xs-12" style="width:80%;margin-bottom:40px!important;margin-top:40px!important;margin-left:100px!important;font-size:18px;height:80px;border:1px solid black;text-align:center;line-height:80px;font-weight:bold;">
                             NOTE DE CRÉDIT
                        </div>
                        <div class="col-xs-12">
                        <table class="table_facture">
                            <tr>
                                <th>DESIGNATION</th>
                                <th>MONTANT</th>
                            </tr>
                            <tr>
                                <td style="height:30px;text-align:left;line-height:30px;font-size:18px;">MONTANT DU REGLEMENT</td>
                                <td style="height:30px;text-align:left;line-height:30px;font-size:18px;"><span t-esc="doc.montant" ></span></td>
                            </tr>
                            <tr>
                                <td style="height:30px;text-align:left;line-height:30px;font-size:18px;">COMMISSION PRODUITS ET ACCESSOIRES</td>
                                <td style="height:30px;text-align:left;line-height:30px;font-size:18px;"><span t-esc="doc.montant_commission" ></span></td>
                            </tr>
                            <tr>
                                <td style="height:30px;text-align:left;line-height:30px;font-size:18px;">MONTANT NET RECEVABLE</td>
                                <td style="height:30px;text-align:left;line-height:30px;font-size:18px;"><span t-esc="doc.montant_net" ></span></td>
                            </tr>
                        </table>
                        </div>
                        
                        <div  class="col-xs-12" style="width:80%;padding:10px 20px!important;margin-top:60px!important;margin-left:100px!important;font-size:18px;border:1px solid black;font-weight:bold;text-align:center;border-bottom:none;">
                           Arrêtée la présente Facture à la somme TTC de francs CFA :
                        </div>
                        <div class="col-xs-12" style="width:80%;height:auto;font-size:18px;border:1px solid black;margin-left:100px!important;text-align:center;">
                           <span t-esc="doc.getMontantWords()" ></span>
                        </div>
                        
                        <div class="col-xs-12" style="margin-top:40px;margin-bottom:100px;" >
                            <div class="col-xs-4" style="border:1px solid black;height:100px;margin:0px;padding:0px;">
                                <div  class="col-xs-12" style="height:40px;border-bottom:1px solid black;margin:0px;padding:0px;text-align:center;line-height:40px;"><strong>MODE DE PAIEMENT</strong></div>
                                <div  class="col-xs-12"  style="height:60px;margin:0px;padding:0px;text-align:center;line-height:40px;"><strong><span t-esc="doc.type_payment" ></span></strong></div>
                            </div>
                            <div class="col-xs-3"></div>
                            <div class="col-xs-5" style="border:1px solid black;height:200px;margin:0px;padding:0px;">
                                <div  class="col-xs-12" style="height:40px;border-bottom:1px solid black;margin:0px;padding:0px;text-align:center;line-height:40px;"><strong>SERVICE MONETIQUE</strong></div>
                                <div  class="col-xs-12" style="height:120px;border-bottom:1px solid black;margin:0px;padding:0px;"></div>
                                <div  class="col-xs-12"  style="height:40px;margin:0px;padding:0px;text-align:center;line-height:40px;"><strong><span t-esc="doc.create_uid.name" ></span> </strong></div>
                            </div>
                        </div>

                        

                    </div>

                    <div class="footer" style="width:100%;min-height:80px;position:absolute:bottom:0px">
                        <img class="img img-responsive" src="/benin_petro/static/img/pied.jpg"  />
                    </div>	
                    </div>
				</t>
			</t>
		</template>




			<report
			id="report_facture_facture_promoteur"
			string="FACTURE PROMOTEUR"
			model="benin_petro.tv_station_hestory"
			report_type="qweb-pdf"
			file="benin_petro.facture_promoteur"
			name="benin_petro.facture_promoteur"
			paperformat="paperformat_euro_landscape"/>
    </data>
</odoo>
