<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="sale_purchase_facture_repport">
            <t t-call="report.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="header" style="min-height:100px;margin:0;padding:0;">
						<!-- <img class="img img-responsive" src="/benin_petro/static/img/ent.jpg"/> -->
                        <img  class="img img-responsive" t-att-src="'data:image/png;base64,%s' % doc.partner_id.company_id.entete"/>

					</div>
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-xs-6">
                               <p>Bon de Commande</p>
                               <table class="table table-bordered">
                                    <tr>
                                        <td>N de piece</td>
                                        <td>Date</td>
                                    </tr>
                                    <tr>
                                        <td><span t-field="doc.name" ></span></td>
                                        <td><span t-field="doc.date_order" ></span></td>
                                    </tr>
                                    <tr>
                                        <td>Reference dossier</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Etabli par</td>
                                        <td><span t-field="doc.create_uid" ></span></td>
                                    </tr>
                                    <tr>
                                        <td>Sce demandeur</td>
                                        <td><span t-field="doc.order_line[0].account_analytic_id" ></span></td>
                                    </tr>
                               </table>
                                
                            </div>
                            <div class="col-xs-5 col-xs-offset-1">
                            <table class="table table-bordred" >
                            <thead>
                                <tr>
                                    <th colspan="2" class="text-center" >INFORMATION FOURNISSEUR</th>
                                </tr>
                            </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="2" ><span t-field="doc.partner_id" ></span></td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" ><span t-field="doc.partner_id.street" ></span></td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-bordred">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Date de livraison</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span t-field="doc.name" ></span></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                                
                            </table>
                            </div>
                        </div>
                            

                    <table class="table table-bordered">`
                        <thead>
                                <tr>
                                    <th>Désignation</th>
                                    <th class="text-right">Qté</th>
                                    <th class="text-right">P.U</th>
                                    <th class="text-right" >Montant HT</th>
                                </tr>
                        </thead>
                        <t t-foreach="doc.order_line" t-as="o">
                            <tr>
                                <th><span t-field="o.product_id"></span><br/><span t-field="o.name" ></span></th>
                                <th class="text-right"><span t-field="o.product_qty"></span></th>
                                <th class="text-right"><span t-field="o.price_unit"></span></th>
                                <th class="text-right" ><span t-field="o.price_subtotal"></span></th>
                            </tr>
                        </t>
                    </table>
                        

                        <div class="row" name="total">
                            <div class="col-xs-6 pull-right">
                                <table class="table table-condensed">
                                    <tr class="border-black">
                                        <td><strong>Total Brut</strong></td>
                                        <td class="text-right">
                                            <span t-field="doc.amount_untaxed" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Remise</td>
                                        <td class="text-right">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>TVA</td>
                                        <td class="text-right">
                                            <span t-field="doc.amount_tax" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>AIB (5%)</td>
                                        <td class="text-right">
                                        </td>
                                    </tr>
                                    <tr class="border-black">
                                        <td><strong>Total</strong></td>
                                        <td class="text-right">
                                            <span t-field="doc.amount_total" />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="row" >
                            <div class="col-xs-6 pull-left" >
                            <strong>
                                <p>Arrete a la somme de F .CFA</p>
                                <p><span t-esc="doc.getMontantWord()" ></span></p>
                            
                            </strong>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-12">
                                <table class="table table-bordered" >
                                    <tr rowspan="4" >
                                        <td class="text-center" style="min-width:100px;height:150px">Le Service demandeur</td>
                                        <td class="text-center" style="min-width:100px;height:150px">Directeur achats et appro</td>
                                        <td class="text-center" style="min-width:100px;height:150px">Directeur Financier et compta</td>
                                        <td class="text-center" style="min-width:100px;height:150px">Directeur General</td>
                                    </tr>
                                    <tr >
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        
                        <div class="oe_structure"/>
                    </div>
                    
                    <div class="footer" style="min-height:300px;">
                        <!-- <img class="img img-responsive" src="/benin_petro/static/img/pd3.jpg"  />  -->
                        <img  class="img img-responsive" t-att-src="'data:image/png;base64,%s' % doc.partner_id.company_id.pied"/>

                    </div>
                </t>
            </t>
        </template>
        <report
        id="report_purches_order_facture"
        string="Facture"
        model="purchase.order"
        report_type="qweb-pdf"
        file="sale_purchase_facture_repport"
        name="benin_petro.sale_purchase_facture_repport"
        paperformat="paperformat_euro_landscape"
        groups="group_benin_petro_adminn"
        />
    </data>
</odoo>