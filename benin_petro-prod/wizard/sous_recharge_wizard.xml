<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form -->
        <record id="wizard_recharger_s_form" model="ir.ui.view">
            <field name="name">Caissier</field>
            <field name="model">benin_petro.wizard.sous.chargeur</field>
            <field name="arch" type="xml">
                <form string="Recharge">
                <field name="id" invisible="1"/>

                            <group><field name="sous_chargeur_id" invisible='1'/>
                            <field name='solde' readonly='1'/>
                            </group>
                            <group>
                                <field string='Type' name='booltest' widget="radio"/>
                            </group>
                            <group>
                                <field name="montant" widget='monetary' string='Montant'/>
                            </group>
                    <footer>
                        <button name="test" string="Sauvegarder" type="object" class="oe_highlight"/>
                        <button string="Annuler" class="oe_link" special="cancel"/>
                    </footer>
                </form>

            </field>
        </record>


        <act_window id="wizard_recharge_s_action"
                    name="Recharger Caissier SUBLIME CARTE"
                    res_model="benin_petro.wizard.sous.chargeur"
                    src_model="benin_petro.sous_chargeur"
                    key2="client_action_multi"
                    view_mode="form"
                    target="new"
                    view_type="form"
		    groups="group_benin_petro_chargeur"
			/>





    </data>
</odoo>
    
