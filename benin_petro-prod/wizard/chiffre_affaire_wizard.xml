<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form -->
        <record id="chiffre_affaire_wizard_formm" model="ir.ui.view">
            <field name="name">Chiffres d'affaires par PDV</field>
            <field name="model">benin_petro.wizard.chiffre_affaire</field>
            <field name="arch" type="xml">
                <form string="Etat">
                    <group col="3">
                        <group string="Point de vente">
                            <field name="point_vente_id" />
                        </group>
                        <group string="Produit">
                            <field name="product_id" />
                        </group>
                        <group string="Type de vente">
                            <field name="type_vente" />
                        </group>
                    
                    </group>
                    <group>
                        <group string="Date début">
                            <field name="start_date" />
                        </group>
                        <group string="Date fin">
                            <field name="end_date" />
                        </group>
                    </group>
                    <footer>
                        <button name="print_report" string="PDF" type="object" class="oe_highlight"/>
                        <button string="Annuler" class="oe_link" special="cancel"/>
                    </footer>
                </form>

            </field>
        </record>


       <record model="ir.actions.act_window" id="chiffre_affaire_wizard_form">
            <field name="name">Chiffres d'affaires par PDV</field>
            <field name="res_model">benin_petro.wizard.chiffre_affaire</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="chiffre_affaire_wizard_formm" />
            <field name="target">new</field>
        </record>

         
        
</data>
</odoo>
