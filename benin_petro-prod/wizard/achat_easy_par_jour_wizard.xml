<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form -->
        <record id="achat_easy_par_jour_wizard_formm" model="ir.ui.view">
            <field name="name">Achat SUBLIME CARTE</field>
            <field name="model">benin_petro.wizard.achat_easy_par_jour</field>
            <field name="arch" type="xml">
                <form string="Etat">
                    <group col="2">
                        <group string="Date début">
                            <field name="date_debut" />
                        </group>
                        <group string="Date fin">
                            <field name="date_fin" />
                        </group>
                    </group>
                    <footer>
                        <button name="print_report" string="PDF" type="object" class="oe_highlight"/>
                        <button string="Annuler" class="oe_link" special="cancel"/>
                    </footer>
                </form>

            </field>
        </record>


       <record model="ir.actions.act_window" id="achat_easy_par_jour_wizard_form">
            <field name="name">Achat SUBLIME CARTE par jour</field>
            <field name="res_model">benin_petro.wizard.achat_easy_par_jour</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="achat_easy_par_jour_wizard_formm" />
            <field name="target">new</field>
        </record>

         
        
</data>
</odoo>