<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form -->
        <record id="point_jour_wizard_formm" model="ir.ui.view">
            <field name="name">Point du jour</field>
            <field name="model">benin_petro.wizard.point_jour</field>
            <field name="arch" type="xml">
                <form string="Etat">
                    <group col="1">
                        <group string="Date">
                            <field name="date" />
                        </group>
                    </group>
                    <footer>
                        <button name="print_report" string="PDF" type="object" class="oe_highlight"/>
                        <button string="Annuler" class="oe_link" special="cancel"/>
                    </footer>
                </form>

            </field>
        </record>


       <record model="ir.actions.act_window" id="point_jour_wizard_form">
            <field name="name">Point du jour</field>
            <field name="res_model">benin_petro.wizard.point_jour</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="point_jour_wizard_formm" />
            <field name="target">new</field>
        </record>

         
        
</data>
</odoo>